PORT=8080

# Database: MySQL produksi, schema terpisah untuk dev.
DB_URL=jdbc:mysql://10.8.0.1:33060/expense_tracker_dev?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=expense-tracker-dev
DB_PASSWORD=change-me

UPLOAD_DIR=/app/uploads
ACCESS_CODE=change-me
ACCESS_ALLOW_BLANK=false

# Notifier produksi (STB via WireGuard).
NOTIFIER_URL=http://10.8.0.4:8081
NOTIFIER_TOKEN=change-me

# Email dev wajib lewat test mode; compose juga memaksa nilai ini.
NOTIFY_EMAILS=
NOTIFY_TEST_MODE=true
NOTIFY_TEST_EMAIL=developer@example.com

INBOX_ENABLED=false
REPORT_ENABLED=false
REPORT_ZONE=Asia/Jakarta

GEMINI_API_KEY=
AI_MODEL=gemini-3.8-flash
AI_VOICE_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT=600
AI_MAX_ATTEMPTS=5
AI_RETRY_DELAY_MS=2000
AI_RETRY_AFTER_CAP_MS=120000
DEEPSEEK_API_KEY=
AI_DEEPSEEK_MODEL=deepseek-flash
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com
