PORT=8080
GOOGLE_SHEET_ID=
GOOGLE_TEST_SHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials.json
GOOGLE_BUDGET_SHEET=Budget

# Notifikasi email via microservice notifier
# Provider: smtp (Gmail) atau resend (Resend API). Pakai resend jika SMTP diblokir (mis. Linode).
MAIL_PROVIDER=smtp
NOTIFY_EMAILS=email1@example.com,email2@example.com
# Mode testing: hanya kirim ke NOTIFY_TEST_EMAIL (abaikan NOTIFY_EMAILS)
NOTIFY_TEST_MODE=false
NOTIFY_TEST_EMAIL=your-email@gmail.com
NOTIFIER_URL=http://notifier:8081

# Opsi SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_APP_PASSWORD=your-gmail-app-password
SMTP_FROM=your-email@gmail.com

# Opsi Resend
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=Expense Tracker <onboarding@resend.dev>
