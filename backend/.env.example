PORT=8080

# Database
DB_URL=jdbc:mysql://mysql:3306/expense_tracker?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=expense
DB_PASSWORD=expense-pass
UPLOAD_DIR=/app/uploads

# Shared access code (wajib di produksi). API fail-closed bila kosong.
ACCESS_CODE=123456
# true hanya untuk development; mematikan autentikasi API saat ACCESS_CODE kosong.
ACCESS_ALLOW_BLANK=false

# Notifikasi email via microservice notifier
MAIL_PROVIDER=smtp
NOTIFY_EMAILS=email1@example.com,email2@example.com
NOTIFY_TEST_MODE=false
NOTIFY_TEST_EMAIL=your-email@gmail.com
NOTIFIER_URL=http://notifier:8081
NOTIFIER_TOKEN=

# Report PDF periode otomatis
REPORT_ENABLED=true
REPORT_CRON=0 5 0 * * *
REPORT_GRACE_DAYS=1
REPORT_ZONE=Asia/Jakarta

# SMTP (dipakai notifier; backend memakai kredensial yang sama untuk IMAP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_APP_PASSWORD=your-gmail-app-password
SMTP_FROM=your-email@gmail.com

# Resend (fallback notifier)
RESEND_API_KEY=
RESEND_FROM=Expense Tracker <onboarding@resend.dev>

# AI (scan struk, voice note, parsing email)
GEMINI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
AI_VOICE_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT=60
AI_MAX_ATTEMPTS=5
AI_RETRY_DELAY_MS=2000
AI_RETRY_AFTER_CAP_MS=120000
DEEPSEEK_API_KEY=
AI_DEEPSEEK_MODEL=deepseek-flash
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com

# Polling email (IMAP) & auto-scan attachment
INBOX_ENABLED=false
INBOX_HOST=imap.gmail.com
INBOX_PORT=993
INBOX_USER=
INBOX_APP_PASSWORD=
INBOX_FOLDER=INBOX
INBOX_POLL_MS=300000
INBOX_SENDERS=klikbca.com,bca.co.id,danamon.co.id
INBOX_SCAN_SENDERS=superindo.co.id
INBOX_DISCARD_MERCHANTS=
INBOX_LOOKBACK_DAYS=3
INBOX_MAX_PER_POLL=50
